{
    "name": "CRM",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "start:dev": "nodemon --watch src --ext ts --legacy-watch --exec tsx src/app.ts",
        "build": "tsc",
        "start": "node dist/app.js",
        "lint": "eslint .",
        "lint:openapi": "redocly lint docs/openapi.yaml --config redocly.yaml",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:typecheck": "tsc --project tests/tsconfig.json --noEmit",
        "docker:dev": "docker compose -f docker-compose.dev.yaml up --build",
        "docker:dev:down": "docker compose -f docker-compose.dev.yaml down",
        "docker:dev:down:volumes": "docker compose -f docker-compose.dev.yaml down -v",
        "docker:dev:migrate": "docker compose -f docker-compose.dev.yaml exec app npx prisma migrate dev",
        "docker:prod": "docker compose -f docker-compose.yaml up --build -d",
        "docker:prod:down": "docker compose -f docker-compose.yaml down"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.3.0",
        "nunjucks": "^3.2.4",
        "swagger-ui-express": "^5.0.1",
        "vitest": "^5.0.3",
        "yaml": "^2.9.1",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@redocly/cli": "^2.60.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.4.1",
        "@types/nunjucks": "^3.2.6",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.9",
        "prisma": "^5.22.0",
        "tsx": "^4.23.13",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.71.1"
    },
    "imports": {
        "#config/*": "./src/config/*",
        "#utils/*": "./src/utils/*",
        "#middlewares/*": "./src/middlewares/*",
        "#modules/*": "./src/modules/*",
        "#public/*": "./src/public/*",
        "#routes/*": "./src/routes/*",
        "#views/*": "./src/views/*",
        "#constants/*": "./src/constants/*",
        "#schemas/*": "./src/schemas/*",
        "#types/*": "./src/types/*",
        "#scripts/*": "./src/scripts/*"
    }
}
