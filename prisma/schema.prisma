generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  RECRUITER
  HR
  WORKER
}

model Company {
  id   String @id @default(dbgenerated("gen_random_uuid()"))
  name String @unique

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  employees    Employee[]
  userAccounts UserAccount[]
  hierarchy    Hierarchy[]
  aboutUs      AboutUs[]
  events       Event[]
  projects     Project[]
  estimates    Estimate[]

  @@map("companies")
}

model Employee {
  id          String       @id @default(dbgenerated("gen_random_uuid()"))
  companyId   String       @map("company_id")
  fullName    String?      @map("full_name")
  imageId     String?      @map("image_id")
  level       String?
  position    String?
  phoneNumber String?      @map("phone_number")
  slack       String?
  telegram    String?
  viber       String?
  whatsapp    String?
  discord     String?
  userAccount UserAccount?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  subordinates        Hierarchy[]        @relation("HierarchyManager")
  managers            Hierarchy[]        @relation("HierarchySubordinate")
  eventParticipations EventParticipant[]

  // Composite key target so child rows can only reference employees of their own company.
  @@unique([id, companyId])
  @@index([companyId])
  @@map("employees")
}

model UserAccount {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  employeeId   String    @unique @map("employee_id")
  companyId    String    @map("company_id")
  // Globally unique: login identifies the account, and its company, by email alone.
  email        String    @unique
  passwordHash String    @map("password_hash")
  roleKey      Role      @map("role_key")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  ownedEvents Event[]
  estimates   Estimate[]

  @@unique([id, companyId])
  // Required by Prisma for the one-to-one composite relation to Employee.
  @@unique([employeeId, companyId])
  @@index([companyId])
  @@map("user_accounts")
}

model Hierarchy {
  id            String @id @default(dbgenerated("gen_random_uuid()"))
  employeeId    String @map("employee_id")
  subordinateId String @map("subordinate_id")
  companyId     String @map("company_id")

  manager     Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade, name: "HierarchyManager")
  subordinate Employee @relation(fields: [subordinateId, companyId], references: [id, companyId], onDelete: Cascade, name: "HierarchySubordinate")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, subordinateId])
  @@index([companyId])
  @@map("hierarchy")
}

model AboutUs {
  id          String @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String
  companyId   String @map("company_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("about_us")
}

enum EventType {
  LEAVE
  SICK_LEAVE
  VACATION
  TIME_OFF
  MEETING
}

model Event {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  type        EventType
  title       String    @db.VarChar(200)
  description String    @db.VarChar(4000)
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  timeZone    String    @map("time_zone") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerAccountId String @map("owner_account_id")
  companyId      String @map("company_id")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner   UserAccount @relation(fields: [ownerAccountId, companyId], references: [id, companyId], onDelete: Restrict)

  participants EventParticipant[]

  @@unique([id, companyId])
  @@index([companyId, startsAt, endsAt])
  @@index([ownerAccountId])
  @@map("events")
}

model EventParticipant {
  eventId    String @map("event_id")
  employeeId String @map("employee_id")
  // Duplicated from the event so both foreign keys can require the same company.
  companyId  String @map("company_id")

  event    Event    @relation(fields: [eventId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([eventId, employeeId])
  @@index([employeeId, eventId])
  @@map("event_participants")
}

model Project {
  id          String @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String
  companyId   String @map("company_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("projects")
}

model Estimate {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String   @db.VarChar(100)
  description String   @db.VarChar(1000)
  time        Float?
  payment     Decimal? @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdBy String @map("created_by")
  companyId String @map("company_id")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator UserAccount @relation(fields: [createdBy, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, deletedAt])
  @@index([createdBy])
  @@map("estimates")
}
