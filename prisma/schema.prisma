generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  RECRUITER
  HR
  WORKER
}

model User {
  id   String @id @default(dbgenerated("gen_random_uuid()"))
  role Role
}

enum EmployeeStatus {
  hired
  active
  on_leave
  fired

  @@map("employee_status")
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed

  @@map("ticket_status")
}

/// Людина в організації: профіль, позиція в ієрархії, дані картки.
model Employee {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name             String         @db.VarChar(255)
  image_id              String?        @db.Uuid // PFP; FK на files додасться разом з модулем файлів
  level                 String?        @db.VarChar(50)
  position              String?        @db.VarChar(150)
  contacts              Json           @default("{}")
  experience_start_date DateTime?      @db.Date
  status                EmployeeStatus @default(hired)
  hired_at              DateTime?      @db.Date
  manager_id            String?        @db.Uuid
  leave_balance_days    Decimal        @default(0) @db.Decimal(5, 1)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  manager      Employee?             @relation("EmployeeHierarchy", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates Employee[]            @relation("EmployeeHierarchy")
  account      UserAccount?
  compensation EmployeeCompensation?
  experiences  EmployeeExperience[]
  tickets      Ticket[]

  @@index([manager_id])
  @@index([status])
  @@index([full_name])
  @@map("employees")
}

/// Доступ до CRM: креденшіали, роль, стан. Не існує без Employee.
model UserAccount {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id   String    @unique @db.Uuid
  email         String    @unique @db.VarChar(255) // lower-case: CHECK у міграції
  password_hash String    @db.VarChar(255)
  role_key      String    @db.VarChar(64) // FK -> roles.key додасть CRM-102.1
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Restrict)

  @@index([role_key])
  @@map("user_accounts")
}

/// Зарплата окремо від Employee (щоб не потрапляла в Employee DTO).
model EmployeeCompensation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String   @unique @db.Uuid
  salary      Decimal  @db.Decimal(12, 2)
  currency    String   @default("UAH") @db.Char(3)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_compensations")
}

model EmployeeExperience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String    @db.Uuid
  company     String    @db.VarChar(255)
  title       String    @db.VarChar(255)
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  description String?
  created_at  DateTime  @default(now())

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("employee_experiences")
}

model Ticket {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String       @db.Uuid
  title       String       @db.VarChar(255)
  description String?
  status      TicketStatus @default(open)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id, status])
  @@map("tickets")
}