PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-session-secret

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/db?schema=public
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5433
DATABASE_DB=db

BCRYPT_COST=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# false is allowed only for local HTTP in development.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Generate at least 32 random bytes; see docs/auth-integration.md.
JWT_SECRET=
JWT_EXPIRES_IN=3600
