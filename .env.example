PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-session-secret

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/db?schema=public
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5433
DATABASE_DB=db

BCRYPT_COST=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# false is allowed only for local HTTP in development.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Generate at least 32 random bytes; see docs/auth-integration.md.
JWT_SECRET=
JWT_EXPIRES_IN=3600

# Google Calendar sync: the CRM Google account organizes events and invites participants
# by their login email; see docs/google-calendar.md.
GOOGLE_CALENDAR_ENABLED=false
# OAuth client of type "Desktop app" from Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtained once with `npm run google:auth` while signed in as the CRM Google account.
GOOGLE_OAUTH_REFRESH_TOKEN=
# Calendar of the CRM account that holds the events; "primary" is its main calendar.
GOOGLE_CALENDAR_ID=primary
# Per-request timeout in milliseconds (1000-7000).
GOOGLE_CALENDAR_TIMEOUT_MS=5000
