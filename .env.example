PORT=3000
NODE_ENV=development
SESSION_SECRET=secret-secret-secret-secret-secret-secret
# Leave empty for direct access. Behind a proxy, list only its IPs or narrow CIDRs.
TRUSTED_PROXIES=

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/db?schema=public
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5433
DATABASE_DB=db
BCRYPT_COST=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Set false only for local HTTP development with NODE_ENV=development.
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Configure a strong secret locally. JWT TTL matches expiresIn and cookie Max-Age.
JWT_SECRET=
JWT_EXPIRES_IN=3600

# Initial admin seed; set ADMIN_PASSWORD locally, never commit a real password.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

JWT_SECRET=secret-secret-secret-secret-secret-secret
JWT_EXPIRES_IN=3600
