<aside class="sidebar" aria-label="Main navigation">
  <nav class="primary-nav">
    <a href="/home"{% if activePage == "home" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-home" aria-hidden="true"></span><span>Home</span>
    </a>
    <a href="/calendar"{% if activePage == "calendar" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-calendar" aria-hidden="true"></span><span>Calendar</span>
    </a>
    <a href="/documents"{% if activePage == "documents" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-documents" aria-hidden="true"></span><span>Documents</span>
    </a>
    <a href="/allowance"{% if activePage == "allowance" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-allowance" aria-hidden="true"></span><span>Allowance</span>
    </a>
    <a href="/salary"{% if activePage == "salary" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-salary" aria-hidden="true"></span><span>Salary</span>
    </a>
    <a href="/projects"{% if activePage == "projects" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-projects" aria-hidden="true"></span><span>Projects</span>
    </a>
    <div class="sidebar-group{% if activePage == 'hierarchy' or activePage == 'employees' %} is-open{% endif %}">
      <div class="sidebar-parent">
        <a href="/hierarchy"{% if activePage == "hierarchy" %} class="is-active" aria-current="page"{% endif %}>
          <span class="nav-icon nav-icon-employees" aria-hidden="true"></span><span>Employees</span>
        </a>
        <button type="button" class="sidebar-toggle" aria-expanded="{% if activePage == 'hierarchy' or activePage == 'employees' %}true{% else %}false{% endif %}" aria-controls="employee-submenu" aria-label="Toggle employee menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
        </button>
      </div>
      <div id="employee-submenu" class="sidebar-submenu"{% if activePage != "hierarchy" and activePage != "employees" %} hidden{% endif %}>
        <a href="/employees/create"{% if activePage == "employees" %} class="is-active" aria-current="page"{% endif %}>
          <span class="nav-icon nav-icon-create-employee" aria-hidden="true"></span><span>Create employee</span>
        </a>
      </div>
    </div>
    <a href="/profile"{% if activePage == "profile" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-profile" aria-hidden="true"></span><span>Profile</span>
    </a>
    <a href="/settings"{% if activePage == "settings" %} class="is-active" aria-current="page"{% endif %}>
      <span class="nav-icon nav-icon-settings" aria-hidden="true"></span><span>Settings</span>
    </a>
  </nav>
</aside>
