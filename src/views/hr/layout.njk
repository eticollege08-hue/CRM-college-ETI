<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}CRM{% endblock %}</title>
  <style>
    :root { --bg:#f6f7f9; --card:#fff; --text:#1c2230; --muted:#6b7385; --line:#e3e6ec; --accent:#2f5bea; }
    @media (prefers-color-scheme: dark) { :root { --bg:#12151c; --card:#1b1f29; --text:#e8eaf0; --muted:#8e97ab; --line:#2a3040; --accent:#7b9bff; } }
    * { box-sizing: border-box; }
    body { margin:0; font:15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; background:var(--bg); color:var(--text); }
    main { max-width:1100px; margin:0 auto; padding:24px 16px; }
    a { color:var(--accent); text-decoration:none; }
    h1 { font-size:22px; margin:0 0 16px; }
    h2 { font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin:0 0 10px; }
    .grid { display:grid; gap:16px; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); }
    .block { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:16px; }
    .wide { grid-column:1 / -1; }
    .muted { color:var(--muted); }
    .pfp { width:72px; height:72px; border-radius:50%; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:26px; font-weight:600; }
    .head { display:flex; gap:16px; align-items:center; }
    .badge { display:inline-block; padding:1px 8px; border-radius:99px; border:1px solid var(--line); font-size:12px; }
    table { width:100%; border-collapse:collapse; background:var(--card); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
    th, td { text-align:left; padding:10px 12px; border-bottom:1px solid var(--line); }
    ul { margin:0; padding-left:18px; }
    .scroll { overflow-x:auto; }
  </style>
</head>
<body>
<main>
  {% if not_found %}<h1>404</h1><p class="muted">Співробітника не знайдено. <a href="/employees">До списку</a></p>
  {% else %}{% block content %}{% endblock %}{% endif %}
</main>
</body>
</html>