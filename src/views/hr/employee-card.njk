{% extends "hr/layout.njk" %}
{% block title %}{{ employee.full_name }} · CRM{% endblock %}
{% block content %}
<p><a href="/employees">← Співробітники</a></p>
<div class="grid">

  <section class="block wide head">
    <div class="pfp" title="PFP">{{ initials }}</div>
    <div>
      <h1 style="margin:0">{{ employee.full_name }}</h1>
      <div class="muted">{{ employee.position or "Позицію не вказано" }}</div>
      <div style="margin-top:6px">
        <span class="badge">{{ employee.status }}</span>
        {% if employee.level %}<span class="badge">{{ employee.level }}</span>{% endif %}
        {% if account %}<span class="badge">акаунт: {{ account.role_key }}{% if not account.is_active %} (неактивний){% endif %}</span>
        {% else %}<span class="badge">без акаунта</span>{% endif %}
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Контакти</h2>
    {% if employee.contacts and (employee.contacts | length) %}
      <ul>{% for k, v in employee.contacts %}<li><b>{{ k }}</b>: {{ v }}</li>{% endfor %}</ul>
    {% else %}<span class="muted">—</span>{% endif %}
    {% if account %}<p class="muted">Email акаунта: {{ account.email }}</p>{% endif %}
  </section>

  <section class="block">
    <h2>Ієрархія</h2>
    <p>Керівник: {% if manager %}<a href="/employees/{{ manager.id }}">{{ manager.full_name }}</a>{% else %}<span class="muted">— (корінь)</span>{% endif %}</p>
    <p class="muted" style="margin:0 0 4px">Підлеглі ({{ subordinates | length }}):</p>
    <ul>{% for s in subordinates %}<li><a href="/employees/{{ s.id }}">{{ s.full_name }}</a></li>{% else %}<li class="muted">—</li>{% endfor %}</ul>
  </section>

  <section class="block">
    <h2>Досвід</h2>
    <p>
      {% if experience_years !== null %}Загальний стаж: <b>{{ experience_years }} р.</b> (з {{ employee.experience_start_date }})
      {% else %}<span class="muted">Дата початку стажу не вказана</span>{% endif %}
    </p>
    <ul>{% for x in experience %}
      <li>{{ x.title }} · {{ x.company }} <span class="muted">({{ x.start_date }} — {{ x.end_date or "н.ч." }})</span></li>
    {% else %}<li class="muted">Записів немає</li>{% endfor %}</ul>
  </section>

  <section class="block">
    <h2>Зарплата</h2>
    {% if compensation %}<b>{{ compensation.salary }} {{ compensation.currency }}</b>{% else %}<span class="muted">—</span>{% endif %}
  </section>

  <section class="block">
    <h2>Відпустка</h2>
    Баланс: <b>{{ employee.leave_balance_days }}</b> дн.<br>
    <span class="muted">Прийнято: {{ employee.hired_at or "—" }}</span>
  </section>

  <section class="block"><h2>Проєкти</h2><span class="muted">Поза межами цього епіку</span></section>
  <section class="block"><h2>Сертифікації</h2><span class="muted">Поза межами цього епіку</span></section>

  <section class="block wide">
    <h2>Тікети</h2>
    <div class="scroll"><table>
      <thead><tr><th>Назва</th><th>Статус</th><th>Створено</th></tr></thead>
      <tbody>{% for t in tickets %}
        <tr><td>{{ t.title }}</td><td><span class="badge">{{ t.status }}</span></td><td>{{ t.created_at | truncate(10, true, '') }}</td></tr>
      {% else %}<tr><td colspan="3" class="muted">Тікетів немає</td></tr>{% endfor %}</tbody>
    </table></div>
  </section>

</div>
{% endblock %}