{% extends "hr/layout.njk" %}
{% block title %}Співробітники · CRM{% endblock %}
{% block content %}
<h1>Співробітники</h1>
<div class="scroll">
<table>
  <thead><tr><th>ПІБ</th><th>Позиція</th><th>Рівень</th><th>Статус</th></tr></thead>
  <tbody>
  {% for e in employees %}
    <tr>
      <td><a href="/employees/{{ e.id }}">{{ e.full_name }}</a></td>
      <td>{{ e.position or "—" }}</td>
      <td>{{ e.level or "—" }}</td>
      <td><span class="badge">{{ e.status }}</span></td>
    </tr>
  {% else %}
    <tr><td colspan="4" class="muted">Поки немає співробітників</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endblock %}