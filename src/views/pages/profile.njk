{% extends "base/base.njk" %}
{% block title %}Profile · CRM{% endblock %}
{% block content %}
{% include "partials/header.njk" %}
<div class="app-shell profile-shell">
  {% include "partials/sidebar.njk" %}
  <main class="workspace profile-workspace">
    <header class="page-heading"><div><h1><svg class="heading-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>Profile</h1><p>View and manage your personal information</p></div></header>
    <form id="profile-edit-form" class="profile-page-grid" novalidate>
      <section class="profile-card card profile-information-card">
        <header class="section-heading"><div><h2>Profile information</h2><p>Update your personal details. Position and salary are managed by administrator.</p></div></header>
        <div class="profile-avatar-wrap">
          <div class="profile-avatar" aria-label="Profile photo" role="img">{{ profile.initials }}</div>
          <label class="avatar-upload-button" for="profile-avatar-file" title="Change profile photo" aria-label="Change profile photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v13H4zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg></label>
          <input id="profile-avatar-file" type="file" accept="image/png,image/jpeg" hidden>
        </div>
        <p class="avatar-hint">JPG, PNG up to 5 MB</p>
        <label class="profile-input-label" for="full-name"><span class="required-field-title">Full name <span class="required-mark">*</span></span>
          <input id="full-name" name="fullName" value="{{ profile.employee.fullName or '' }}" maxlength="150" required autocomplete="name">
          <small class="field-error" data-error-for="fullName" aria-live="polite"></small>
        </label>
        <label class="profile-input-label" for="profile-position">Position
          <span class="locked-field"><input id="profile-position" value="{{ profile.employee.position or 'HR Manager' }}" disabled><svg class="detail-icon" viewBox="0 0 24 24" role="img" aria-label="Locked"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
        </label>
        <label class="profile-input-label" for="profile-salary">Salary
          <span class="locked-field"><input id="profile-salary" value="$4,500 / month" disabled><svg class="detail-icon" viewBox="0 0 24 24" role="img" aria-label="Locked"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
        </label>
        <div class="profile-form-actions"><button id="cancel-profile-edit" class="secondary-button" type="button">Cancel</button><button id="save-profile" class="primary-button" type="submit" disabled>Save</button></div>
      </section>
      <div class="profile-side-column">
        <section class="profile-card card contact-card">
          <header class="section-heading"><div><h2>Contact information</h2><p>Manage your contact details</p></div></header>
          <div class="contact-input-grid">
            <label class="profile-input-label" for="profile-phone"><span class="required-field-title">Phone number <b class="required-mark">*</b></span><span class="contact-input-control"><img class="detail-icon" src="/icons/phone-icon.svg" alt=""><input id="profile-phone" name="phoneNumber" type="tel" value="{{ profile.employee.phoneNumber or '+380 00 000 00 00' }}" maxlength="30" autocomplete="tel" required></span><small class="field-error" data-error-for="phoneNumber" aria-live="polite"></small></label>
            <label class="profile-input-label" for="profile-email"><span class="required-field-title">Email <b class="required-mark">*</b></span><span class="contact-input-control"><img class="detail-icon" src="/icons/email-icon.svg" alt=""><input id="profile-email" name="email" type="email" value="{{ profile.email }}" maxlength="254" required autocomplete="email"></span><small class="field-error" data-error-for="email" aria-live="polite"></small></label>
            <label class="profile-input-label" for="profile-slack"><span class="required-field-title">Slack</span><span class="contact-input-control"><img class="detail-icon brand-icon" src="/icons/slack.svg" alt=""><input id="profile-slack" name="slack" value="{{ profile.employee.slack or 'anderson_liam' }}" placeholder="Enter your Slack username" maxlength="100"></span><small class="field-error" aria-hidden="true"></small></label>
            <label class="profile-input-label" for="profile-telegram"><span class="required-field-title">Telegram</span><span class="contact-input-control"><img class="detail-icon" src="/icons/telegram.svg" alt=""><input id="profile-telegram" name="telegram" value="{{ profile.employee.telegram or '@ander_son' }}" placeholder="@username" maxlength="100"></span><small class="field-error" aria-hidden="true"></small></label>
            <label class="profile-input-label" for="profile-viber"><span class="required-field-title">Viber</span><span class="contact-input-control"><img class="detail-icon" src="/icons/viber.svg" alt=""><input id="profile-viber" name="viber" type="tel" value="{{ profile.employee.viber or '+380 00 000 00 00' }}" placeholder="+380 00 000 00 00" maxlength="30"></span><small class="field-error" data-error-for="viber" aria-live="polite"></small></label>
            <label class="profile-input-label" for="profile-whatsapp"><span class="required-field-title">WhatsApp</span><span class="contact-input-control"><svg class="detail-icon whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-12 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/><path d="M9 8c.5 3 2 4.5 5 6l1-1 2 1c-.5 2-2 2-3 2-4-1-6-4-7-7 0-1 1-2 2-2l1 2Z"/></svg><input id="profile-whatsapp" name="whatsapp" type="tel" value="{{ profile.employee.whatsapp or '+380 00 000 00 00' }}" placeholder="+380 00 000 00 00" maxlength="30"></span><small class="field-error" data-error-for="whatsapp" aria-live="polite"></small></label>
            <label class="profile-input-label" for="profile-discord"><span class="required-field-title">Discord</span><span class="contact-input-control"><svg class="detail-icon discord-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 6a16 16 0 0 1 10 0l3 12a14 14 0 0 1-4 2l-1-2a12 12 0 0 1-6 0l-1 2a14 14 0 0 1-4-2L7 6Z"/><path d="M9 13h.1M15 13h.1"/></svg><input id="profile-discord" name="discord" value="{{ profile.employee.discord or 'liam_anderson' }}" placeholder="Enter your Discord username" maxlength="100"></span><small class="field-error" aria-hidden="true"></small></label>
          </div>
        </section>
        <section id="account-information" class="profile-card card account-card">
          <header class="section-heading"><div><h2>Account information</h2><p>Additional information (view only)</p></div></header>
          <dl>
            <dt><img class="detail-icon" src="/icons/position-icon.svg" alt="">Position</dt><dd>{{ profile.employee.position or 'Sales Specialist' }} <span class="role-badge">CRM {{ profile.roleKey | title }}</span></dd>
            <dt><img class="detail-icon" src="/icons/level-icon.svg" alt="">Level</dt><dd>{{ profile.employee.level or 'Level 3' }}</dd>
            <dt><img class="detail-icon" src="/icons/team-icon.svg" alt="">Team</dt><dd>Team name</dd>
            <dt><img class="detail-icon" src="/icons/experience-icon.svg" alt="">Experience</dt><dd>5 years</dd>
            <dt><img class="detail-icon" src="/icons/certifications-icon.svg" alt="">Certifications</dt><dd><a href="/hierarchy">{{ profile.employee.position or 'Sales Specialist' }}</a></dd>
          </dl>
        </section>
      </div>
      <p id="profile-save-message" class="profile-toast" role="status" aria-live="polite" hidden></p>
    </form>
  </main>
</div>
{% endblock %}
