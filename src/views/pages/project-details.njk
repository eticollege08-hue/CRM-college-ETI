{% extends "base/base.njk" %}
{% block title %}{{ project.title }} · Projects{% endblock %}
{% block content %}
{% include "partials/header.njk" %}
<div class="app-shell project-details-shell">
  {% include "partials/sidebar.njk" %}
  <main class="workspace project-details-workspace" data-project-id="{{ project.id }}" data-project-title="{{ project.title }}" data-project-description="{{ project.description }}">
    <div class="project-details-toolbar">
      <a class="project-back-link" href="/projects"><span class="project-back-icon" aria-hidden="true">←</span><span>Back to projects</span></a>
      <div class="project-actions">
        <button type="button" class="project-action-button" data-project-edit>Edit project</button>
        <button type="button" class="project-action-button project-delete-trigger" data-project-delete>Delete</button>
      </div>
    </div>

    <header class="project-detail-hero">
      <span class="project-detail-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16"/></svg></span>
      <div class="project-detail-title"><div><h1>{{ project.title }}</h1><span class="project-detail-status">Status not set</span></div><p>{{ project.description }}</p></div>
    </header>

    <section class="project-detail-panels">
      <article class="project-detail-panel project-description-panel"><h2>Description</h2><p>{{ project.description }}</p></article>
    </section>

    <div class="project-additional-info"><span aria-hidden="true">i</span><span>No additional information</span></div>
  </main>
</div>

<dialog class="project-dialog" data-project-dialog>
  <form data-project-form>
    <div class="project-dialog-heading"><div><h2>Edit project</h2><p>Update the project name and description.</p></div><button type="button" class="project-dialog-close" aria-label="Close" data-project-close>×</button></div>
    <label>Project name<input name="title" required maxlength="120" value="{{ project.title }}"></label>
    <label>Description<textarea name="description" required maxlength="1000" rows="4">{{ project.description }}</textarea></label>
    <p class="project-form-error" role="alert" data-project-error></p>
    <div class="project-dialog-actions"><button type="button" class="secondary-button" data-project-close>Cancel</button><button class="primary-button" type="submit" data-project-submit>Save changes</button></div>
  </form>
</dialog>
<dialog class="project-delete-dialog" data-delete-dialog>
  <form method="dialog" data-delete-form>
    <div class="project-dialog-heading"><h2>Delete project</h2><button type="submit" class="project-dialog-close" aria-label="Close">×</button></div>
    <div class="project-delete-warning"><span aria-hidden="true">⚠</span><p>This action cannot be undone.<br>To confirm, enter the project name.</p></div>
    <label class="project-delete-label" for="delete-project-name">Project name</label>
    <input id="delete-project-name" class="project-delete-input" type="text" autocomplete="off" placeholder="Enter project name..." data-delete-name>
    <div class="project-dialog-actions"><button type="submit" class="secondary-button">Cancel</button><button type="button" class="project-delete-confirm" data-delete-confirm disabled>Delete project</button></div>
  </form>
</dialog>
<dialog class="project-feedback-dialog" data-feedback-dialog aria-labelledby="feedback-title" aria-describedby="feedback-message">
  <div class="project-feedback-content" data-feedback-kind="success">
    <div class="project-feedback-heading"><span class="project-feedback-icon" aria-hidden="true" data-feedback-icon>✓</span><h2 id="feedback-title" data-feedback-title>Success</h2><button type="button" class="project-feedback-close" aria-label="Close" data-feedback-close>×</button></div>
    <p id="feedback-message" data-feedback-message></p>
    <button type="button" class="project-feedback-button" data-feedback-close>OK</button>
  </div>
</dialog>
<aside class="project-notifications" aria-label="Notifications" aria-live="polite" data-notifications hidden></aside>
{% endblock %}
