{% extends "base/base.njk" %}
{% block content %}
{% include "partials/header.njk" %}
<div class="app-shell">{% include "partials/sidebar.njk" %}<main class="workspace">
<h1>Employees</h1>
{% if profile.roleKey in ["OWNER","RECRUITER"] %}<a href="/employees/create">Create employee</a>{% endif %}
<form method="get">{% for key,label in [ ["level","Level"],["position","Position"] ] %}<label>{{ label }} <input name="{{ key }}" value="{{ query[key] }}"></label>{% endfor %}<label>Team <select name="teamId"><option value="">All teams</option>{% for team in teams %}<option value="{{ team.id }}" {% if query.teamId == team.id %}selected{% endif %}>{{ team.name }}</option>{% endfor %}</select></label><label>Project <select name="projectId"><option value="">All projects</option>{% for project in projects %}<option value="{{ project.id }}" {% if query.projectId == project.id %}selected{% endif %}>{{ project.title }}</option>{% endfor %}</select></label><button>Filter</button></form>
<ul>{% for employee in employees %}<li>{% if employee.imageId %}<img width="40" height="40" src="/api/employees/{{ employee.id }}/photo" alt="">{% endif %}<a href="/employees/{{ employee.id }}/profile">{{ employee.fullName or employee.userAccount.email or "Employee" }}</a> {{ employee.level }} {{ employee.position }}</li>{% else %}<li>No employees found.</li>{% endfor %}</ul>
{% if previous %}<a href="{{ previous }}">Previous</a>{% endif %} Page {{ page }} {% if next %}<a href="{{ next }}">Next</a>{% endif %}
</main></div>{% endblock %}
