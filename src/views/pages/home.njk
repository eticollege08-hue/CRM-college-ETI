{% extends "base/base.njk" %}
{% block title %}Home · CRM{% endblock %}
{% block content %}
  {% include "partials/header.njk" %}
  <div class="app-shell">
    {% include "partials/sidebar.njk" %}
    <main class="workspace">
      <div class="page-heading">
        <div><h1><svg class="heading-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="3"/><circle cx="5" cy="19" r="3"/><circle cx="19" cy="19" r="3"/><path d="M12 8v5M5 16v-3h14v3"/></svg>Employees Hierarchy</h1><p>Manage and view your team structure</p></div>
        <a class="primary-button add-button" href="/employees/create">＋ Add employee</a>
      </div>
      <div class="dashboard-layout">
        <aside class="team-panel card">
          <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search by employee name…"></label>
          <div class="filter-row"><button type="button">Filters</button><button type="button">Team⌄</button><button type="button">Level⌄</button><button type="button">Position⌄</button><a href="#clear">Clear</a></div>
          <ul class="team-list">
            {% for person in team %}
            <li class="team-member{% if loop.first %} is-selected{% endif %}" style="--depth: {{ person.depth }}">
              <span class="tree-branch" aria-hidden="true">{% if person.depth %}↳{% else %}⌄{% endif %}</span>
              <span class="avatar">{{ person.initials }}</span>
              <span class="member-copy"><strong>{{ person.name }}</strong><small>{{ person.position }}</small></span>
              <span class="role-badge {{ person.roleClass }}">{{ person.role }}</span>
            </li>
            {% endfor %}
          </ul>
        </aside>
        <section class="profile-panel card" aria-label="Employee profile">
          <div class="profile-overview">
            <span class="avatar avatar-large" aria-hidden="true">UN</span>
            <div class="profile-title"><h2>User Name <span class="role-badge role-hr">CRM HR</span></h2><p>HR Manager&nbsp; · &nbsp;Level 3</p><div class="contact-line"><a href="mailto:user@email.company.com"><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>user@email.company.com</a><a href="tel:+380000000000"><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h3l2 5-2 1a12 12 0 0 0 7 7l1-2 5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>+380 00 000 00 00</a><span><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Zm-5 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>Kyiv, Ukraine</span></div></div>
            <a class="primary-button edit-button" href="/profile">Edit</a>
            <button class="icon-button more-button" type="button" aria-label="More actions">⋮</button>
          </div>
          <nav class="profile-tabs" aria-label="Employee details"><a class="is-active" href="#overview">Overview</a><a href="#projects">Projects</a><a href="#leave">Leave</a><a href="#tickets">Tickets</a><a href="#documents">Documents</a><a href="#history">History</a></nav>
          <div class="profile-grid">
            <article class="detail-card card"><h3>Personal Information <a href="/profile" aria-label="Edit personal information">✎</a></h3><dl><dt><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg>Full name</dt><dd>User Name</dd><dt><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 2-5 10-10a2 2 0 0 1 3 3L9 18l-5 2Zm10-13 3 3"/></svg>Position</dt><dd>HR Manager</dd><dt><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h17M8 15l4-4 3 2 5-6"/></svg>Level</dt><dd>Level 3</dd><dt><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m6-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm6-7a4 4 0 0 1 0 8m2 3h2a3 3 0 0 1 3 3v1"/></svg>Team</dt><dd>Team name</dd><dt><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>Experience</dt><dd>5 years</dd><dt><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12Zm-3 11-1 7 4-2 4 2-1-7"/></svg>Certifications</dt><dd>HR Management&nbsp; · &nbsp;Recruiting</dd></dl></article>
            <article class="detail-card card"><h3>Contact Information <a href="/profile" aria-label="Edit contact information">✎</a></h3><dl><dd><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h3l2 5-2 1a12 12 0 0 0 7 7l1-2 5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>+380 00 000 00 00</dd><dd><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>user@email.company.com</dd><dd><svg class="home-detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Zm-5 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>Kyiv, Ukraine</dd></dl></article>
            <article class="detail-card card"><h3>Salary <a href="/profile" aria-label="View profile information">✎</a></h3><dl><dt>Monthly salary</dt><dd>$4,500</dd><dt>Hourly rate</dt><dd>$27.50</dd><dt>Bonus</dt><dd>$500</dd></dl></article>
            <article class="detail-card card"><h3>Projects <span class="count-badge">2</span><a href="/profile" aria-label="View profile information">✎</a></h3><div class="project-placeholder"><span></span><span></span><span></span></div><a class="view-link" href="#projects">View all projects →</a></article>
          </div>
        </section>
      </div>
    </main>
  </div>
{% endblock %}
