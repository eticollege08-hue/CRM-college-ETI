{% extends "base/base.njk" %}
{% block title %}Create employee · CRM{% endblock %}
{% block content %}
{% include "partials/header.njk" %}
<div class="app-shell">
  {% include "partials/sidebar.njk" %}
<main class="workspace employee-create-page">
  <header class="page-heading"><div><h1><svg class="heading-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M19 8v6M16 11h6"/></svg>Create employee</h1><p>Add a new employee to the CRM system</p></div></header>
  <section class="form-card">
    <h2>Employee information</h2><p class="muted">Basic information about the employee</p>
    <form id="employee-form" novalidate>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg>Full name <span>*</span></span><input name="fullName" autocomplete="name" placeholder="Enter full name" required><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h3l2 5-2 1a12 12 0 0 0 7 7l1-2 5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>Phone number <span>*</span></span><input name="phone" type="tel" autocomplete="tel" placeholder="+380 00 000 00 00" required><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>Email <span>*</span></span><input name="email" type="email" autocomplete="email" placeholder="name@company.com" required><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg>Password <span>*</span></span><input name="password" type="password" autocomplete="new-password" placeholder="Create password" required><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v14H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>Position <span>*</span></span><select name="position" required><option value="" selected disabled>Select position</option>{% for position in positions %}<option value="{{ position }}">{{ position }}</option>{% endfor %}</select><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m6-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm6-7a4 4 0 0 1 0 8m2 3h2a3 3 0 0 1 3 3v1"/></svg>Manager <span>*</span></span><select name="manager" required><option value="">Select manager</option>{% for employee in employees %}<option value="{{ employee.id }}">{{ employee.fullName }}</option>{% endfor %}</select><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>Experience <span>*</span></span><input name="experience" type="number" min="0" step="1" placeholder="Years of experience" required><small></small></label>
      <label><span class="field-title"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 8.5c-.7-.7-1.7-1-3-1-1.7 0-3 .8-3 2s1.2 1.8 3 2 3 .8 3 2-1.3 2-3 2c-1.2 0-2.3-.4-3-1.1M12 5.5v13"/></svg>Salary <span>*</span></span><input name="salary" type="number" min="1" step="0.01" placeholder="Per month" required><small></small></label>
      <div class="form-actions"><button id="cancel-button" class="button button-secondary" type="button">Cancel</button><button class="button button-primary" type="submit">Save</button></div>
      <p id="form-message" class="form-message" role="status" aria-live="polite"></p>
    </form>
  </section>
</main>
</div>
{% endblock %}
