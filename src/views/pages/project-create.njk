{% extends "base/base.njk" %}
{% block title %}Create project · CRM{% endblock %}
{% block content %}
{% include "partials/header.njk" %}
<div class="app-shell project-create-shell">
  {% include "partials/sidebar.njk" %}
  <main class="workspace project-create-workspace">
    <form class="project-create-card" data-project-create-form data-owner-id="{{ profile.employee.id }}">
      <a class="project-create-back" href="/projects"><span aria-hidden="true">←</span>Back to projects</a>
      <header class="project-create-heading"><h1>Create project</h1><p>Add new project to the company</p></header>

      <div class="project-create-fields">
        <label class="project-create-field" data-field="title"><span>Title <b>*</b></span><input name="title" required maxlength="120" placeholder="Enter project name"><small data-field-error="title">Title is required</small></label>
        <label class="project-create-field" data-field="ownerId"><span>Owner <b>*</b></span><select name="ownerId" required><option value="" disabled>Select project owner</option>{% for employee in employees %}<option value="{{ employee.id }}"{% if employee.id == profile.employee.id %} selected{% endif %}>{{ employee.fullName or employee.email or "Unnamed employee" }}</option>{% endfor %}</select><small data-field-error="ownerId">Choose a project owner</small></label>
        <label class="project-create-field" data-field="budget"><span>Price <b>*</b></span><span class="project-price-input"><input name="budget" type="number" min="0.01" step="0.01" required placeholder="Enter amount"><span aria-hidden="true">$</span></span><small data-field-error="budget">Enter a valid price</small></label>
        <label class="project-create-field" data-field="deadline"><span>Deadline <em>(optional)</em></span><span class="project-date-input"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg><input name="deadline" type="date" aria-label="Project deadline"></span></label>
        <label class="project-create-field project-create-full" data-field="description"><span>Description <b>*</b></span><textarea name="description" rows="4" required maxlength="1000" placeholder="Describe the project"></textarea><small class="project-description-count"><span data-description-count>0</span>/1000</small><small data-field-error="description">Description is required</small></label>
      </div>

      <section class="project-create-section project-create-full"><h2>Links</h2><div class="project-link-fields" data-link-fields><label class="project-link-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l3-3A5 5 0 0 0 13 2.9l-1.7 1.7M14 11a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 21.1l1.7-1.7"/></svg><input type="url" placeholder="Add link" aria-label="Project link"></label></div><button class="project-create-outline-button" type="button" data-add-link>＋ Add link</button></section>

      <section class="project-create-section project-create-full"><h2>Team</h2><div class="project-team-selection" data-team-selection><p>No team members yet</p><span>Add team members to the project</span></div><div class="project-team-chips" data-team-chips></div><button class="project-create-outline-button" type="button" data-open-team>＋ Add team</button></section>

      <p class="project-create-error" role="alert" data-create-error></p>
      <div class="project-create-actions"><a class="project-create-cancel" href="/projects">Cancel</a><button class="primary-button" type="submit" data-create-submit>Create project</button></div>
    </form>
  </main>
</div>

<dialog class="project-team-dialog" data-team-dialog>
  <div class="project-team-dialog-heading"><div><h2>Add team members</h2><p>Select employees for this project.</p></div><button type="button" class="project-dialog-close" aria-label="Close" data-close-team>×</button></div>
  <label class="project-team-search">Search employees<input type="search" placeholder="Search by name" data-team-search></label>
  <div class="project-team-options" data-team-options>
    {% for employee in employees %}
      <label class="project-team-option" data-employee-name="{{ (employee.fullName or employee.email or 'Unnamed employee') | lower }}"><input type="checkbox" value="{{ employee.id }}" data-team-option><span><strong>{{ employee.fullName or employee.email or "Unnamed employee" }}</strong><small>{{ employee.position or "Employee" }}</small></span></label>
    {% else %}<p class="project-team-no-employees">No employees available.</p>{% endfor %}
  </div>
  <div class="project-dialog-actions"><button type="button" class="secondary-button" data-close-team>Cancel</button><button type="button" class="primary-button" data-save-team>Save team</button></div>
</dialog>
{% endblock %}
